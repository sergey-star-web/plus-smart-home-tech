@namespace("ru.yandex.practicum.kafka.telemetry.enums")
protocol SensorEventProtocol {
    // Данные с климатического датчика
        record ClimateSensorAvro {
            int temperature_c;
            int humidity;
            int co2_level;
        }

        // Данные с датчика света
        record LightSensorAvro {
            int link_quality;
            int luminosity;
        }

        // Данные с датчика движения
        record MotionSensorAvro {
            int link_quality;
            boolean motion;
            int voltage;
        }

        // Данные с переключателя
        record SwitchSensorAvro {
            boolean state;
        }

        // Данные с датчика температуры
        record TemperatureSensorAvro {
            string id;
            string hubId;
            long timestamp; // timestamp_ms
            int temperature_c;
            int temperature_f;
        }

        // Основное событие telemetry сенсора
        record SensorEventAvro {
            string id;
            string hubId;
            long timestamp; // timestamp_ms
            union {
                ClimateSensorAvro,
                LightSensorAvro,
                MotionSensorAvro,
                SwitchSensorAvro,
                TemperatureSensorAvro
            } payload;
        }
}